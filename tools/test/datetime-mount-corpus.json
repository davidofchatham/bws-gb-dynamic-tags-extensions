{
	"_note": "Shared by datetime-migration-test.php (D8, the PHP rewrite) and datetime-mount-driver.js (the editor's mount rewrite). `expect` is the rewritten option map, key order included, or null when the tag is left alone.",
	"cases": [
		{ "label": "single: key alone is already the new form", "family": "single", "options": { "key": "a" }, "expect": null, "expectTry": null },
		{ "label": "single: key + timeKey", "family": "single", "options": { "key": "a", "timeKey": "t" }, "expect": { "key": "a+t" }, "expectTry": { "A": "key(a+t)" } },
		{ "label": "single: timeKey alone", "family": "single", "options": { "timeKey": "t" }, "expect": { "key": "+t" }, "expectTry": { "A": "key(+t)" } },
		{ "label": "single: empty timeKey is dropped", "family": "single", "options": { "key": "a", "timeKey": "" }, "expect": { "key": "a" }, "expectTry": { "A": "key(a)" } },
		{ "label": "single: both empty leave no key", "family": "single", "options": { "key": "", "timeKey": "" }, "expect": {}, "expectTry": {} },
		{ "label": "single: operands are trimmed", "family": "single", "options": { "key": " a ", "timeKey": " t " }, "expect": { "key": "a+t" }, "expectTry": { "A": "key(a+t)" } },
		{ "label": "single: other options survive, in canonical order", "family": "single", "options": { "fallback": "TBA", "timeKey": "t", "key": "a", "as": "time" }, "expect": { "as": "time", "key": "a+t", "fallback": "TBA" }, "expectTry": { "as": "time", "A": "key(a+t)", "fallback": "TBA" } },
		{ "label": "single: a + in the key is not a clean entry", "family": "single", "options": { "key": "a+b", "timeKey": "t" }, "expect": null, "expectTry": null },
		{ "label": "single: a ; in the time key is not a clean entry", "family": "single", "options": { "key": "a", "timeKey": "t;u" }, "expect": null, "expectTry": null },
		{ "label": "range: start only", "family": "range", "options": { "startKey": "s" }, "expect": { "key": "s" }, "expectTry": { "A": "key(s)" } },
		{ "label": "range: start with time", "family": "range", "options": { "startKey": "s", "startTimeKey": "st" }, "expect": { "key": "s+st" }, "expectTry": { "A": "key(s+st)" } },
		{ "label": "range: start and end", "family": "range", "options": { "startKey": "s", "endKey": "e" }, "expect": { "key": "s;e" }, "expectTry": { "A": "key(s;e)" } },
		{ "label": "range: all four", "family": "range", "options": { "startKey": "s", "startTimeKey": "st", "endKey": "e", "endTimeKey": "et" }, "expect": { "key": "s+st;e+et" }, "expectTry": { "A": "key(s+st;e+et)" } },
		{ "label": "range: end time only on the end", "family": "range", "options": { "startKey": "s", "endTimeKey": "et" }, "expect": { "key": "s;+et" }, "expectTry": { "A": "key(s;+et)" } },
		{ "label": "range: start time only on the start", "family": "range", "options": { "startTimeKey": "st", "endKey": "e" }, "expect": { "key": "+st;e" }, "expectTry": { "A": "key(+st;e)" } },
		{ "label": "range: start with no time, end with one", "family": "range", "options": { "startKey": "s", "endKey": "e", "endTimeKey": "et" }, "expect": { "key": "s;e+et" }, "expectTry": { "A": "key(s;e+et)" } },
		{ "label": "range: trailing empties are stripped", "family": "range", "options": { "startKey": "s", "startTimeKey": "", "endKey": "", "endTimeKey": "" }, "expect": { "key": "s" }, "expectTry": { "A": "key(s)" } },
		{ "label": "range: a stray key is replaced", "family": "range", "options": { "key": "x", "startKey": "s" }, "expect": { "key": "s" }, "expectTry": { "A": "key(s)" } },
		{ "label": "range: other options survive, in canonical order", "family": "range", "options": { "fallback": "TBA", "endKey": "e", "startKey": "s", "rangeSep": "to" }, "expect": { "rangeSep": "to", "key": "s;e", "fallback": "TBA" }, "expectTry": { "rangeSep": "to", "A": "key(s;e)", "fallback": "TBA" } },
		{ "label": "range: end only is NOT migrated", "endOnly": true, "family": "range", "options": { "endKey": "e" }, "expect": null, "expectTry": null },
		{ "label": "range: end time only is NOT migrated", "endOnly": true, "family": "range", "options": { "endTimeKey": "et" }, "expect": null, "expectTry": null },
		{ "label": "range: end pair is NOT migrated", "endOnly": true, "family": "range", "options": { "endKey": "e", "endTimeKey": "et" }, "expect": null, "expectTry": null },
		{ "label": "range: empty start beside an end is NOT migrated", "endOnly": true, "family": "range", "options": { "startKey": "", "startTimeKey": "", "endKey": "e" }, "expect": null, "expectTry": null },
		{ "label": "range: all four empty is left alone", "family": "range", "options": { "startKey": "", "startTimeKey": "", "endKey": "", "endTimeKey": "" }, "expect": null, "expectTry": null },
		{ "label": "range: key alone is already the new form", "family": "range", "options": { "key": "s;e" }, "expect": null, "expectTry": null },
		{ "label": "range: a ; in an operand is not a clean entry", "family": "range", "options": { "startKey": "a;b", "endKey": "e" }, "expect": null, "expectTry": null },
		{ "label": "try slot A: the read joins the slot, its other tokens and later slots stay", "family": "single", "options": { "A": "src(post,3)", "B": "src(parent)", "key": "a", "timeKey": "t" }, "expect": { "key": "a+t", "A": "src(post,3)", "B": "src(parent)" }, "expectTry": { "A": "src(post,3);key(a+t)", "B": "src(parent)" } },
		{ "label": "try slot A: a dead read in A is replaced", "family": "single", "options": { "A": "src(post,3);key(old)", "key": "a", "timeKey": "t" }, "expect": { "key": "a+t", "A": "src(post,3);key(old)" }, "expectTry": { "A": "src(post,3);key(a+t)" } },
		{ "label": "try slot A: no read stated leaves A alone", "family": "single", "options": { "A": "src(post,3)", "key": "", "timeKey": "" }, "expect": { "A": "src(post,3)" }, "expectTry": { "A": "src(post,3)" } },
		{ "label": "try slot A: a range read lands as one list", "family": "range", "options": { "A": "src(post,3)", "startKey": "s", "startTimeKey": "st", "endKey": "e" }, "expect": { "key": "s+st;e", "A": "src(post,3)" }, "expectTry": { "A": "src(post,3);key(s+st;e)" } },
		{ "label": "try slot A: an unparsable A is left alone", "family": "single", "options": { "A": "src(post", "key": "a", "timeKey": "t" }, "expect": { "key": "a+t", "A": "src(post" }, "expectTry": null }
	]
}
